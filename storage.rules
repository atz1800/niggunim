rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/niggunim/{fileName} {
      // רק המשתמש עצמו יכול להעלות קבצים לתיקייה שלו
      allow write: if request.auth != null && request.auth.uid == userId;
      // קריאה חופשית — ה-download URL קבוע ולא פג תוקף
      allow read: if true;
    }
  }
}
